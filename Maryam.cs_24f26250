using System;

public class CropAnalysisSystem
{
  public string CalculateCropProductivity(double harvestWeight, double farmArea)
    {
    if (harvestWeight <= 0 || farmArea <= 0) 
        {
            return "Invalid Input"; 
        }
    double yield = harvestWeight / farmArea;
        int yieldCategoryKey;

        if (yield >= 2500) 
        {
          yieldCategoryKey = 1; // High
        }
        else if (yield >= 1000) 
        {
          yieldCategoryKey = 2; // Medium
        }
        else 
        {
            yieldCategoryKey = 3; // Low
        }

    switch (yieldCategoryKey)
        {
      case 1:
        return "Category A: High Yield Production (Optimal)";
    case 2:
        return "Category B: Medium Yield Production (Standard)";
    case 3:
        return "Category C: Low Yield Production (Sub-optimal)";
    default:
        return "System Error: Unknown Yield Classification";
}
